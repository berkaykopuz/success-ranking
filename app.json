{
  "expo": {
    "name": "YKS Sıralamam",
    "slug": "success-ranking",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "successranking",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.berkaykopuz1.successranking",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/icons/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.berkaykopuz1.successranking",
      "appName": "YKS Sıralamam",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icons/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB",
          "dark": {
            "backgroundColor": "#2563EB"
          }
        }
      ],
      "expo-dev-client",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7326975715449797~4890783806",
          "iosAppId": "ca-app-pub-7326975715449797~2336891164"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2c9978b-4e05-4a6a-9241-6d3aac0eb704"
      },
      "react-native-google-mobile-ads": {
        "androidAppId": "ca-app-pub-7326975715449797~4890783806",
        "userTrackingUsageDescription": "Tracking"
      }
    }
  }
}
